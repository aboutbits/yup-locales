{
  "name": "@aboutbits/yup-locales",
  "version": "0.0.8",
  "description": "Custom yup locales",
  "keywords": [
    "yup",
    "internationalization",
    "language",
    "languages"
  ],
  "author": "AboutBits",
  "license": "MIT",
  "private": false,
  "main": "en.js",
  "typings": "en.d.ts",
  "scripts": {
    "build": "tsc",
    "lint": "eslint --cache",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.js --passWithNoTests",
    "prepare": "npm run build",
    "prepublishOnly": "npm run test && npm run lint",
    "version": "npm run test && npm run lint && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aboutbits/yup-locales.git"
  },
  "files": [
    "readme.md",
    "it.js",
    "it.d.ts",
    "de.js",
    "de.d.ts",
    "en.js",
    "en.d.ts",
    "ru.js",
    "ru.d.ts"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/aboutbits/yup-locales/issues"
  },
  "homepage": "https://github.com/aboutbits/yup-locales#readme",
  "engines": {
    "npm": ">=10",
    "node": ">=18"
  },
  "devDependencies": {
    "@aboutbits/eslint-config": "^5.1.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "eslint": "^9.39.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.3",
    "yup": "^0.32.11"
  }
}
